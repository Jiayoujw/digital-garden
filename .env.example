# Required for production (Vercel) — GitHub Personal Access Token with 'repo' scope
GITHUB_TOKEN=

# Optional — repo to store notes in (defaults to current repo)
# GITHUB_REPO=Jiayoujw/digital-garden

# Optional — branch to use (defaults to main)
# GITHUB_BRANCH=main

# Force GitHub backend locally for testing (set to 'github')
# STORAGE_BACKEND=
